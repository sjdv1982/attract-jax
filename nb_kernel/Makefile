CXX ?= g++
CXXFLAGS ?= -O3 -DNDEBUG -std=c++17 -march=native -fPIC
# Always add current-directory include so that headers in include/ and
# forcefields/ can find nb_kernel.h via plain #include "nb_kernel.h".
CXXFLAGS_INTERNAL := -I.
LDFLAGS ?= -shared -fopenmp

# ---------------------------------------------------------------------------
# Legacy target: hand-written nonbon8 kernel (backward-compatible).
# The per-FF codegen path (Milestone 3) produces nb_kernel_<name>.so instead.
# ---------------------------------------------------------------------------
TARGET ?= libnbkernel_nonbon8.so
SRC    := nb_kernel.cpp

LEGACY_HEADERS := nb_kernel.h \
    include/euler_rot.h \
    include/pose_loop.h \
    forcefields/nonbon8/lj.h \
    forcefields/nonbon8/lj_grad.h \
    forcefields/nonbon8/elec.h \
    forcefields/nonbon8/elec_grad.h

# ---------------------------------------------------------------------------
# Per-FF codegen targets (Milestone 3+)
#
# Layout:
#   forcefields/<name>/ff.yaml              — force field metadata
#   forcefields/<name>/nb_kernel_<name>.cpp — GENERATED by codegen_ff.py
#   nb_kernel_<name>.so                     — compiled shared library
#
# Discover all force fields that have an ff.yaml.
# ---------------------------------------------------------------------------
FF_YAMLS := $(wildcard forcefields/*/ff.yaml)
FF_NAMES := $(notdir $(patsubst %/ff.yaml,%,$(FF_YAMLS)))
FF_SOS   := $(foreach n,$(FF_NAMES),nb_kernel_$(n).so)

# Headers shared by every per-FF .so compilation (rotation policy + pose loop).
SHARED_HEADERS := nb_kernel.h include/euler_rot.h include/pose_loop.h

.PHONY: all ffs clean

# 'all' builds only the legacy library (unchanged behaviour through M3).
# Use 'make ffs' to build all per-FF shared libraries.
# Use 'make nb_kernel_<name>.so' to build a specific one.
all: $(TARGET)

$(TARGET): $(SRC) $(LEGACY_HEADERS)
	$(CXX) $(CXXFLAGS) $(CXXFLAGS_INTERNAL) $(SRC) -o $@ $(LDFLAGS)

# Build all per-FF libraries discovered via forcefields/*/ff.yaml.
ffs: $(FF_SOS)

# Combined codegen + compile rule: generate .cpp then build .so.
# Using a combined rule avoids a Makefile pattern-rule limitation where a
# prerequisite of the form "forcefields/%/nb_kernel_%.cpp" would contain `%`
# twice, causing Make to substitute only the first occurrence and leave the
# second as a literal `%`.
# $(SHARED_HEADERS) is listed so that changes to euler_rot.h / pose_loop.h
# trigger a rebuild.  Changes to FF physics .h files do NOT auto-trigger a
# rebuild; touch forcefields/<name>/ff.yaml to force one.
nb_kernel_%.so: forcefields/%/ff.yaml codegen_ff.py $(SHARED_HEADERS)
	python3 codegen_ff.py codegen $* forcefields/$*/
	$(CXX) $(CXXFLAGS) $(CXXFLAGS_INTERNAL) forcefields/$*/nb_kernel_$*.cpp -o $@ $(LDFLAGS)

clean:
	rm -f $(TARGET) $(FF_SOS)
	find forcefields -name 'nb_kernel_*.cpp' -delete
